# Weighthouse configuration template.
#
# Copy this file to `.env` next to docker-compose.yml and set the values
# your deployment needs. Only MODEL_STORAGE_PATH matters for a first run;
# everything else has a working default.
#
# Contents:
#   1. Essentials
#   2. Accounts and sessions
#   3. Metadata database
#   4. Hugging Face Hub access
#   5. Transfers
#   6. Storage locations
#   7. Object storage (optional)
#   8. Watch subscriptions

#===========================================================================
# 1. Essentials
#===========================================================================

# Host port serving the web interface and API.
APP_PORT=7860

# Host directory holding model files.
MODEL_STORAGE_PATH=./models

# The container runs as this host user and group; 1000 is the usual first
# user on Linux. Harmless on Windows and macOS.
# PUID=1000
# PGID=1000

#===========================================================================
# 2. Accounts and sessions
#===========================================================================

# Local accounts are on by default; the first browser visit creates the
# owner account. Disabling them takes ALLOW_ACCOUNTLESS=true as well —
# see docs/accounts.md for what that mode implies.
ACCOUNTS_ENABLED=true

# Sign-in session lifetime, in hours.
SESSION_TTL_HOURS=720

# Session cookies are marked Secure, and browsers only send them over
# HTTPS. Serving plain HTTP without a TLS-terminating proxy in front keeps
# sign-ins from persisting; if you accept that trade knowingly, uncomment
# the next line and remove it once TLS is in front.
# ALLOW_INSECURE_COOKIES=true

#===========================================================================
# 3. Metadata database
#===========================================================================

# Leave blank for the default SQLite file in the /data directory. For an
# external PostgreSQL server, set the full connection URL — see
# docs/postgres.md.
DATABASE_URL=

# Used only by the docker-compose.postgres.yml overlay.
# POSTGRES_DB=weighthouse
# POSTGRES_USER=weighthouse
# POSTGRES_PASSWORD=replace-with-a-long-random-password

#===========================================================================
# 4. Hugging Face Hub access
#===========================================================================

# Access token for private or gated repositories. A token granting read
# scope is sufficient.
HF_TOKEN=

# Alternative Hub endpoint.
HF_ENDPOINT=https://huggingface.co

#===========================================================================
# 5. Transfers
#===========================================================================

MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_WORKERS_PER_JOB=4
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_SECONDS=2

# Opt in to the hf_xet client for files Hugging Face serves from the Xet
# CAS. Off by default: the client buffers downloads in memory.
# See docs/downloads.md, "Performance and resources".
ENABLE_XET=0

UPLOAD_CHUNK_MB=8
MAX_UPLOAD_SIZE_GB=1024

#===========================================================================
# 6. Storage locations
#===========================================================================

# Additional named storage locations on this host, declared as one line of
# JSON. Names are lowercase, 40 characters maximum; "primary" is reserved
# for MODEL_STORAGE_PATH itself. Copies can be moved between locations —
# see docs/storage.md.
# LOCATIONS_JSON=[{"name":"archive","root":"/mnt/large-models"}]
LOCATIONS_JSON=[]

#===========================================================================
# 7. Object storage (optional)
#===========================================================================

# Durable storage backend for downloaded model files: filesystem (default)
# or s3.
MODEL_STORAGE_BACKEND=filesystem

# S3-compatible object storage: AWS S3, MinIO, Ceph, Cloudflare R2, and
# compatible services. Uncomment when MODEL_STORAGE_BACKEND=s3 —
# see docs/storage.md.
# S3_BUCKET=my-model-bucket
# S3_PREFIX=models
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://minio:9000
# S3_ADDRESSING_STYLE=path
# S3_USE_SSL=false
# S3_VERIFY_SSL=true
# S3_STORAGE_CLASS=
# S3_MAX_CONCURRENCY=4
# S3_MULTIPART_CHUNK_MB=64

# Object storage credentials. Leave them blank to resolve through the
# standard AWS credential chain instead: AWS_ACCESS_KEY_ID and friends, an
# attached role, or the provider's own chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

#===========================================================================
# 8. Watch subscriptions
#===========================================================================

# Minutes between upstream checks for each watched repository. One check
# per repository per interval.
WATCH_POLL_MINUTES=120
